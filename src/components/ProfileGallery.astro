---
import { profile } from '../data/profile';
import { assetUrl } from '../utils/urls';
const photos = profile.photos;
---
<profile-gallery data-interval={profile.photoIntervalMs} aria-label={'Profile photos of ' + profile.name}>
  <div class="profile-photo-frame">
    {photos.length ? photos.map((photo, index) => <img class:list={['profile-photo', { active: index === 0 }]} src={assetUrl(photo.src)} alt={photo.alt} width="560" height="700" style={{ objectPosition: photo.position || 'center' }} aria-hidden={index !== 0 ? 'true' : undefined} decoding="async" />)
      : <div class="profile-photo-placeholder"><svg width="80" height="92" viewBox="0 0 80 92" fill="none" aria-hidden="true"><circle cx="40" cy="27" r="17" stroke="currentColor" stroke-width="1.5"/><path d="M9 84c0-20 12-33 31-33s31 13 31 33" stroke="currentColor" stroke-width="1.5"/></svg><span>Profile photo</span></div>}
  </div>
  {photos.length > 1 && <div class="profile-photo-controls" hidden>
    <button type="button" data-prev aria-label="Previous profile photo">Prev</button>
    <span data-count aria-live="off">1 / {photos.length}</span>
    <button type="button" data-next aria-label="Next profile photo">Next</button>
    <button type="button" data-toggle hidden aria-label="Pause photo slideshow">Pause</button>
  </div>}
</profile-gallery>
<script>
  class ProfileGallery extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      this.cleanup?.();
      const slides = Array.from(this.querySelectorAll<HTMLImageElement>('.profile-photo'));
      const controls = this.querySelector<HTMLElement>('.profile-photo-controls');
      if (slides.length < 2 || !controls) return;
      const toggle = this.querySelector<HTMLButtonElement>('[data-toggle]')!;
      const count = this.querySelector<HTMLElement>('[data-count]')!;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let playing = !reducedMotion.matches;
      let index = 0;
      let timer: number | undefined;
      const stopTimer = () => { window.clearInterval(timer); timer = undefined; };
      const show = (next: number) => {
        index = (next + slides.length) % slides.length;
        slides.forEach((slide, i) => { slide.classList.toggle('active', i === index); slide.setAttribute('aria-hidden', String(i !== index)); });
        count.textContent = (index + 1) + ' / ' + slides.length;
      };
      const schedule = () => {
        stopTimer();
        toggle.textContent = playing ? 'Pause' : 'Play';
        toggle.setAttribute('aria-label', playing ? 'Pause photo slideshow' : 'Play photo slideshow');
      };
      const previous = () => { show(index - 1); schedule(); };
      const next = () => { show(index + 1); schedule(); };
      const togglePlayback = () => { playing = !playing; schedule(); };
      const preferenceChanged = () => { if (reducedMotion.matches) playing = false; schedule(); };
      this.querySelector('[data-prev]')!.addEventListener('click', previous);
      this.querySelector('[data-next]')!.addEventListener('click', next);
      toggle.addEventListener('click', togglePlayback);
      document.addEventListener('visibilitychange', schedule);
      reducedMotion.addEventListener('change', preferenceChanged);
      controls.hidden = false;
      show(Math.floor(Math.random() * slides.length));
      schedule();
      this.cleanup = () => {
        stopTimer();
        this.querySelector('[data-prev]')?.removeEventListener('click', previous);
        this.querySelector('[data-next]')?.removeEventListener('click', next);
        toggle.removeEventListener('click', togglePlayback);
        document.removeEventListener('visibilitychange', schedule);
        reducedMotion.removeEventListener('change', preferenceChanged);
      };
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('profile-gallery')) customElements.define('profile-gallery', ProfileGallery);
</script>
