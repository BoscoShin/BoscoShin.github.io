<script>
  class PixelRoom extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      this.cleanup?.();
      const button = this.querySelector<HTMLButtonElement>('button')!;
      const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
      let paused = preference.matches;
      const update = () => { this.classList.toggle('paused', paused); button.textContent = paused ? 'Play' : 'Pause'; button.setAttribute('aria-label', paused ? 'Play pixel dancer' : 'Pause pixel dancer'); };
      const toggle = () => { paused = !paused; update(); };
      const motionChanged = () => { if (preference.matches) paused = true; update(); };
      this.classList.add('ready');
      button.hidden = false;
      button.addEventListener('click', toggle);
      preference.addEventListener('change', motionChanged);
      update();
      this.cleanup = () => { button.removeEventListener('click', toggle); preference.removeEventListener('change', motionChanged); };
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('pixel-room')) customElements.define('pixel-room', PixelRoom);
</script>
